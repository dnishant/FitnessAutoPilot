# Server-only LLM configuration for Edge Functions / local dev generation.
# NEVER copy these into apps/mobile or prefix with EXPO_PUBLIC_.

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Server-only Edamam Recipe Search API (PLAN-005 recipe discovery).
# NEVER copy these into apps/mobile or prefix with EXPO_PUBLIC_.
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
# Optional overrides:
# EDAMAM_BASE_URL=https://api.edamam.com/api/recipes/v2
# EDAMAM_TIMEOUT_MS=12000
